{
  "manifest_version": 3,
  "name": "AVN Agent",
  "version": "1.0",
  "description": "Assistant vocal intelligent avec AVN",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "offscreen",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "scripts/background.js"
  },
  "action": {
    "default_title": "AVN Agent",
    "default_icon": {
      "16": "images/icon-16.png",
      "32": "images/icon-32.png",
      "48": "images/icon-48.png",
      "128": "images/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "scripts/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-listen": {
      "suggested_key": {
        "default": "Ctrl+Y",
        "mac": "Ctrl+Y"
      },
      "description": "Activer l'extension AVN"
    }
  },
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  }
}